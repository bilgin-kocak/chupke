# Chupke configuration. Copy to .env and fill in. Never commit .env.
# Empty values mean "not set" (the default applies). See docs/DEPLOY.md for a deploy-ready template.

# --- Worker only (never give these to the web process) ---
# Bitrefill personal API key (bitrefill.com/account/developers). Leave empty when an egress proxy
# injects it (Claude Code "Network secret" for api.bitrefill.com).
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2
# Real (non-test) gift cards are refused and refunded while this is false.
ALLOW_REAL_PURCHASES=false
ZINGO_CLI_PATH=./bin/zingo-cli
# Restore the shop wallet on first start (24 words + birthday height). Remove ZINGO_SEED afterwards.
ZINGO_SEED=
WALLET_BIRTHDAY=
ZINGO_NYM_PROXY=
# Only behind an egress proxy that re-terminates TLS (Claude Code sandbox: /root/.ccr/ca-bundle.crt).
ZINGO_EXTRA_CA_FILE=
# single = one full wallet; split = view-only inbox (from the shop UFVK) watches, full wallet sends.
WALLET_MODE=single
SHOP_WALLET_DIR=./data/wallets/shop
INBOX_WALLET_DIR=./data/wallets/inbox
# Demo payer wallet used by scripts (wallet-smoke, buyer-pay, buyer-inbox).
BUYER_WALLET_DIR=./data/wallets/buyer
SHOP_UFVK=
LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# Raise it if tiny outputs are rejected (1000 zat is accepted on NU7 testnet).
DELIVERY_AMOUNT_ZAT=1000
# After a delivery, return payment minus price when the excess is at least this (smaller excess is kept).
OVERPAY_REFUND_MIN_ZAT=20000
# Per-order diversified addresses kept ready for the web to hand out, one per order (0 = every order shows the shop UA).
ADDRESS_POOL_SIZE=10
DUST_ZAT=20000
TICK_MS=10000
# Wait this long for a possibly-broadcast send to show up in listSent before resending.
RESEND_GUARD_SEC=180
# Ignore received outputs mined below this height (default: the chain tip at the worker's first start).
INGEST_FROM_HEIGHT=
BITREFILL_BALANCE_EVERY_SEC=300

# --- Shared ---
DATABASE_PATH=./data/chupke.db
# Optional: the worker refuses to start if this doesn't match the shop wallet (the web falls back to
# the address the worker publishes in the database).
SHOP_UA=
DEMO_ZAT_PER_USD=100000
MAX_ORDER_USD=10
MAX_DAILY_USD=30
# Free test products count toward MAX_DAILY_USD only when true.
DAILY_CAP_INCLUDES_TEST=false
MIN_CONFIRMATIONS=1
ORDER_TTL_MIN=20
GRACE_MIN=10
PURGE_AFTER_MIN=60
PAUSE_PURCHASES=false
ALLOWLIST_PATH=./config/allowlist.json
EXPLORER_TX_URL=https://testnet.zcashexplorer.app/transactions/

# --- Web ---
PORT=8080
PUBLIC_BASE_URL=
# Enables /dashboard (basic auth, user "chupke"). Unset = no dashboard.
DASHBOARD_PASSWORD=

# --- docker compose only ---
# Host port for the web container.
WEB_PORT=8080
# For `--profile tls` (Caddy, automatic HTTPS); point the domain's DNS at the host first.
DOMAIN=
# Override the image (default ghcr.io/bilgin-kocak/chupke:latest).
CHUPKE_IMAGE=

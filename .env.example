# Chupke configuration. Copy to .env and fill in. Never commit .env.

# --- Worker only (never give these to the web process) ---
# Leave empty when an egress proxy injects the key (Claude Code "Network secret" for api.bitrefill.com).
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2
ALLOW_REAL_PURCHASES=false
ZINGO_CLI_PATH=./bin/zingo-cli
# Restore-only. Prefer the environment over this file; never put it on a command line.
ZINGO_SEED=
ZINGO_NYM_PROXY=
# Only behind an egress proxy that re-terminates TLS (sandbox: /root/.ccr/ca-bundle.crt).
ZINGO_EXTRA_CA_FILE=
WALLET_MODE=single
SHOP_WALLET_DIR=./data/wallets/shop
INBOX_WALLET_DIR=./data/wallets/inbox
# Demo payer wallet used by scripts (wallet-smoke, buyer-pay).
BUYER_WALLET_DIR=./data/wallets/buyer
SHOP_UFVK=
WALLET_BIRTHDAY=
LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# Raise it if tiny outputs are rejected.
DELIVERY_AMOUNT_ZAT=1000
DUST_ZAT=20000
TICK_MS=10000

# --- Shared ---
DATABASE_PATH=./data/chupke.db
SHOP_UA=
DEMO_ZAT_PER_USD=100000
MAX_ORDER_USD=10
MAX_DAILY_USD=30
MIN_CONFIRMATIONS=1
ORDER_TTL_MIN=20
GRACE_MIN=10
PURGE_AFTER_MIN=60
PAUSE_PURCHASES=false
ALLOWLIST_PATH=./config/allowlist.json

# --- Web ---
PORT=8080
PUBLIC_BASE_URL=
DASHBOARD_PASSWORD=

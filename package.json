{
  "name": "chupke",
  "version": "0.1.0",
  "private": true,
  "description": "Pay shielded ZEC, get a gift card code in your encrypted memo inbox.",
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:zingo": "scripts/build-zingo.sh",
    "wallet:smoke": "tsx scripts/wallet-smoke.ts",
    "bitrefill:smoke": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/bitrefill-smoke.ts",
    "bitrefill:buy-once": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--disable-warning=UNDICI-EHPA tsx scripts/bitrefill-buy-once.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
